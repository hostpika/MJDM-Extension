{
  "name": "@mjdm/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "build:all": "wxt build -b chrome && wxt build -b firefox --mv3",
    "zip:all": "wxt zip -b chrome && wxt zip -b firefox --mv3",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mjdm/shared-types": "workspace:*",
    "preact": "^10.26.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wxt": "^0.20.1"
  },
  "packageManager": "pnpm@12.16.1"
}
